#!/usr/bin/env bash
# dayz-ctl — the ONE privileged action script. Installed at /usr/local/bin/dayz-ctl
# and callable by the API service ONLY as `sudo dayz-ctl <verb> [arg...]`
# (see api.sudoers). This is the entire privilege surface of the API:
# a closed verb set, every argument re-validated here regardless of what the caller
# claims to have checked. Rendered from this template by Deploy-Api.ps1
# (__UNIT__ / __SERVER_DIR__ filled in) — never hand-edit the installed copy.
set -euo pipefail

UNIT='__UNIT__'
SERVER_DIR='__SERVER_DIR__'
RCON="$SERVER_DIR/dayz-rcon.ps1"   # shipped by the DayZ deploy; talks to localhost RCon
CONFIG_MAP='__CONFIG_MAP__'        # rendered "name<TAB>relpath<TAB>group<TAB>label<TAB>ro<TAB>kind" file allowlist (config-registry.json, DayZ-Server repo); kind = the registry 'web' value (view/file/patch/types/...) - the editor picks its view by it
CONFIG_DIRS='__CONFIG_DIRS__'      # rendered "group<TAB>reldir<TAB>subfolders" folder allowlist
IGNORE_EXT='__IGNORE_EXT__'        # global comma list of extensions hidden from FOLDER listings
WRITE_MAP='__WRITE_MAP__'          # rendered "name<TAB>relpath" WRITE mask (config-registry.json entries flagged "writable")
GENERATED='__GENERATED__'          # rendered relpath globs of COMPILER OUTPUTS (config-registry.json "generated") - read-only; own-write refuses to target them
DISABLED_TARGETS='__DISABLED_TARGETS__'  # rendered relpaths of config surfaces whose owning mod is DISABLED in mods.conf (config-registry.json "mod" x deploy/mods.conf, resolved at deploy time) - the web editor DROPS these rows
OWNED_FILES='__OWNED_FILES__'      # rendered relpaths of registry FILE rows with category:'owned' - the generic own-read/own-write allowlist; '*' = a glob segment (e.g. the mission), one row covers every match
OWNED_DIRS='__OWNED_DIRS__'        # rendered reldirs of registry FOLDER rows with category:'owned' - files under these are own-read/own-write reachable (json/xml only, replace-only)
OWNED_CHECKS='__OWNED_CHECKS__'    # rendered "glob<TAB>check" rows (registry 'structure' field) - own-write runs the named structural validator on matching paths, on top of the extension parse
DENY_LIST='__DENY_LIST__'          # rendered prefixes (registry denyList) - paths underneath are INVISIBLE and UNREACHABLE: never listed, never read, never written. THE boundary of editable-by-default
NOISE_RE='__LOG_NOISE__'           # rendered ERE (deploy.config.json Dayz.LogNoiseFilter); log-read hides matching lines unless 'raw'
DOCS_ROOTS='__DOCS_ROOTS__'        # space-separated globs under SERVER_DIR to scan for mod docs (deploy.config.json Docs.Roots, e.g. "@*")
DOCS_EXT='__DOCS_EXT__'            # comma list of doc extensions (Docs.Extensions, e.g. md,txt,xml,json)
DOCS_NAMES='__DOCS_NAMES__'        # space list of doc basename prefixes (Docs.Names, e.g. readme license) - catches extensionless files
DOCS_MAXDEPTH='__DOCS_MAXDEPTH__'  # find maxdepth within each root (Docs.MaxDepth)
LOG_SOURCES='__LOG_SOURCES__'      # rendered "id<TAB>reldir<TAB>glob<TAB>label" log-source registry (deploy.config.json Dayz.LogSources); log-sources/log-list/log-read resolve an id to its dir + filename glob

die() { echo "dayz-ctl: $*" >&2; exit 1; }

# The SHARED spawn store: one neutral file feeding BOTH AIB and Expansion (Build-AIBandits,
# Build-AILocations, Build-AIPatrols all read it). Neutral location, not under any one mod's folder.
SPAWNS="$SERVER_DIR/profiles/AI_Shared/map-points.json"
SPAWN_VERSIONS="$SERVER_DIR/.spawn-versions"

# Same pattern for the map-points store (keep the 10 newest). A save is reversible from these.
snapshot_spawns() {
  [ -f "$SPAWNS" ] || return 0
  mkdir -p "$SPAWN_VERSIONS"
  cp -p "$SPAWNS" "$SPAWN_VERSIONS/map-points.$(date -u +%Y%m%dT%H%M%S%NZ).json"
  find "$SPAWN_VERSIONS" -maxdepth 1 -name 'map-points.*.json' | sort -r | tail -n +11 \
    | while IFS= read -r _old; do rm -f "$_old"; done
  _own="$(stat -c '%u:%g' "$SERVER_DIR" 2>/dev/null || echo '')"
  [ -n "$_own" ] && chown -R "$_own" "$SPAWN_VERSIONS" 2>/dev/null || true
}

# Read + print ONE config file: the resolved relpath on line 1, then the contents with
# well-known secret values masked (backstop; the allowlists exclude secret-bearing files).
# Callers pass a relpath THEY resolved from an allowlist — this never forms a path from
# caller input. Exit 2 = not present, 3 = too large.
print_config_file() {
  _rel="$1"
  _file="$SERVER_DIR/$_rel"
  [ -f "$_file" ] || { echo "dayz-ctl: config file not present: $_rel" >&2; exit 2; }
  # Defence in depth: the resolved real path must stay under the server dir
  # (guards against a symlink slipped into an allowlisted folder).
  _base="$(realpath -- "$SERVER_DIR" 2>/dev/null || printf '%s' "$SERVER_DIR")"
  _real="$(realpath -- "$_file" 2>/dev/null || printf '')"
  case "$_real" in "$_base"/*) ;; *) die "config resolved outside the server dir" ;; esac
  _sz="$(wc -c < "$_file")"
  [ "$_sz" -le 786432 ] || { echo "dayz-ctl: config too large ($_sz bytes): $_rel" >&2; exit 3; }
  printf '%s\n' "$_rel"
  sed -E 's/((passwordadmin|password|token|secret|apikey|api_key)"?[[:space:]]*[:=][[:space:]]*")[^"]*/\1REDACTED/Ig' "$_file"
}

# True if a path's BASENAME qualifies as documentation: extension in DOCS_EXT, or the name
# starts with a DOCS_NAMES prefix (catches extensionless LICENSE/NOTICE). Case-insensitive.
is_doc() {
  _b="${1##*/}"; _lc="${_b,,}"; _e="${_b##*.}"
  case ",${DOCS_EXT,,}," in *",${_e,,},"*) return 0 ;; esac
  for _p in $DOCS_NAMES; do case "$_lc" in "${_p,,}"*) return 0 ;; esac; done
  return 1
}

# Resolve a log-source id (deploy.config.json Dayz.LogSources) to its "reldir<TAB>glob".
# Prints nothing and returns 1 for an unknown id. The id set is a closed rendered table,
# so log-list/log-read never form a dir or glob from caller input - only the id is matched.
log_source_lookup() {
  _hit="$(printf '%s\n' "$LOG_SOURCES" | awk -F'\t' -v id="$1" '$1==id{print $2"\t"$3; exit}')"
  [ -n "$_hit" ] || return 1
  printf '%s\n' "$_hit"
}



# --- Generated-artifact guard -----------------------------------------------------------------
# A prestart COMPILER writes these (config-registry.json "generated"); they are read-only outputs,
# never edit inputs. GENERATED holds one ServerDir-relative glob per line ('*' = the mission
# wildcard). A case-glob '*' spans '/' too, which is exactly what we want for the mission segment.
_is_generated() {
  # $1 = a concrete ServerDir-relative path. exit 0 = generated (locked), 1 = not.
  [ -n "$GENERATED" ] || return 1
  _rel_ig="$1"; _oldifs_ig="$IFS"; IFS=$'\n'
  for _g in $GENERATED; do
    [ -n "$_g" ] || continue
    case "$_rel_ig" in $_g) IFS="$_oldifs_ig"; return 0 ;; esac
  done
  IFS="$_oldifs_ig"; return 1
}
# --- Deny boundary --------------------------------------------------------------------------
# $1 under a DENY_LIST prefix? Plain string-prefix semantics, same as the deny-list gate
# asserts offline. Checked BEFORE any grant so no mask can override a denial.
_denied() {
  [ -n "$DENY_LIST" ] || return 1
  while IFS= read -r _dl; do
    [ -n "$_dl" ] || continue
    case "$1" in "$_dl"*) return 0 ;; esac
  done <<EOF
$DENY_LIST
EOF
  return 1
}

# A CONFIG_MAP row with ro='1' (registry web:'view') is a locked surface: readable, never
# writable - whichever verb carries the write.
_locked_row() {
  [ -n "$CONFIG_MAP" ] || return 1
  printf '%s\n' "$CONFIG_MAP" | awk -F'\t' -v r="$1" '$2==r && $5=="1"{found=1; exit} END{exit !found}'
}

# --- Owned-file guard (the generic own-read/own-write allowlist) ----------------------------
# <name>.<ext> -> <name>.defaults.<ext>; extensionless -> <name>.defaults. The frozen state-0
# companion of an owned file: how capture-on-write finds where to put the baseline, and how
# own-read serves it back for the side-by-side diff.
_defaults_path() {
  case "$1" in
    *.*) printf '%s.defaults.%s' "${1%.*}" "${1##*.}" ;;
    *)   printf '%s.defaults' "$1" ;;
  esac
}

# Strip a .defaults marker back to the live stem, or print nothing if there is none.
# 'a/b.defaults.json' -> 'a/b.json'
_defaults_stem() {
  case "$1" in
    *.defaults.*) printf '%s.%s' "${1%.defaults.*}" "${1##*.defaults.}" ;;
    *.defaults)   printf '%s' "${1%.defaults}" ;;
    *)            printf '' ;;
  esac
}

# Is <relpath> a readable/writable OWNED config file? Guards in order: syntax, the OWNED
# masks (registry category:'owned', rendered at deploy time), the generated mask (artifacts
# are never edit inputs), the disabled-mod mask, existence (replace-only - a typo'd path
# can't create files),
# and the realpath jail. Return 0 = allowed, 2 = refused with the reason on stderr.
# `|| true` guards on the greps: a no-match grep in a plain statement would trip set -e.
# $2 = 'read' | 'write' (default write). A <stem>.defaults.<ext> companion is READABLE when
# its STEM is an owned surface, and never writable. This closes two defects in the naive mask
# checks:
#   - OWNED_FILES is matched with grep -qxF (exact), so a companion beside a FILE row would be
#     refused outright - "view default side by side" would be impossible.
#   - OWNED_DIRS is a PREFIX match, so a companion under an owned dir would be fully WRITABLE -
#     an admin could overwrite a frozen baseline through the API.
# Same rule fixes both: resolve the mask against the stem, allow read, refuse write.
_own_check() {
  _r="$1"
  _mode="${2:-write}"
  case "$_r" in ''|*..*|/*) echo "dayz-ctl: invalid owned path: $_r" >&2; return 2 ;; esac
  case "$_r" in *[!A-Za-z0-9_./-]*) echo "dayz-ctl: invalid owned path: $_r" >&2; return 2 ;; esac
  # NO FILE-TYPE LIST: the extension is a VALIDATION concern, never an ACCESS one. The write path
  # below already dispatches a parser per extension and falls through for anything it does not
  # know, so an unrecognised type is a normal writable file that simply is not parse-checked.
  # Path safety is unchanged - the two guards above still reject traversal and odd characters.
  _maskpath="$_r"
  _stem="$(_defaults_stem "$_r")"
  if [ -n "$_stem" ]; then
    [ "$_mode" = read ] || { echo "dayz-ctl: the frozen default is read-only - edit the live file: $_r" >&2; return 2; }
    _maskpath="$_stem"
  fi
  _hit=''
  { printf '%s\n' "$OWNED_FILES" | grep -qxF "$_maskpath" && _hit=1; } || true
  if [ -z "$_hit" ] && [ -n "$OWNED_FILES" ]; then
    # Glob rows: same '*' semantics as the generated mask (shell case, '*' may span '/'). One
    # registry row with a '*' mission segment covers every mission - no hand-kept per-mission list.
    while IFS= read -r _f; do
      case "$_f" in
        *\**) case "$_maskpath" in $_f) _hit=1; break ;; esac ;;
      esac
    done <<EOF
$OWNED_FILES
EOF
  fi
  if [ -z "$_hit" ] && [ -n "$OWNED_DIRS" ]; then
    while IFS= read -r _d; do
      [ -n "$_d" ] || continue
      case "$_maskpath" in "$_d"/*) _hit=1; break ;; esac
    done <<EOF
$OWNED_DIRS
EOF
  fi
  # THE DENY BOUNDARY, before any default: a denied path is unreachable however it is asked for.
  if _denied "$_maskpath"; then echo "dayz-ctl: denied path: $_r" >&2; return 2; fi
  # THE FLIP: json/xml is a config surface BY DEFAULT. The masks above are explicit GRANTS
  # (they can cover any extension, e.g. ban.txt); everything else says no by exception -
  # deny list, generated mask, disabled-mod mask, view-locked rows, missing file.
  if [ -z "$_hit" ]; then
    case "$_maskpath" in *.json|*.xml) _hit=1 ;; esac
  fi
  [ -n "$_hit" ] || { echo "dayz-ctl: not a config surface (json/xml by default; other types need an explicit grant): $_r" >&2; return 2; }
  if [ "$_mode" != read ] && _locked_row "$_maskpath"; then
    echo "dayz-ctl: read-only surface: $_r" >&2; return 2
  fi
  if _is_generated "$_maskpath"; then echo "dayz-ctl: generated artifact - edit the inputs, never the output: $_r" >&2; return 2; fi
  if [ -n "$DISABLED_TARGETS" ] && printf '%s\n' "$DISABLED_TARGETS" | grep -qxF "$_maskpath"; then
    echo "dayz-ctl: owning mod is disabled in mods.conf: $_r" >&2; return 2
  fi
  [ -f "$SERVER_DIR/$_r" ] || { echo "dayz-ctl: owned file not present: $_r" >&2; return 2; }
  _b="$(realpath -- "$SERVER_DIR" 2>/dev/null || printf '%s' "$SERVER_DIR")"
  _real="$(realpath -- "$SERVER_DIR/$_r" 2>/dev/null || printf '')"
  case "$_real" in "$_b"/*) ;; *) echo "dayz-ctl: owned file resolved outside the server dir" >&2; return 2 ;; esac
  return 0
}


# Emit the full set of retrievable configs, one file per line, TAB-separated:
#   group <TAB> name <TAB> relpath <TAB> label <TAB> ro
# Sources: explicit files (CONFIG_MAP "name<TAB>relpath<TAB>group<TAB>label<TAB>ro<TAB>kind")
# and every real file under each allowlisted folder (CONFIG_DIRS "group<TAB>reldir").
# `find -type f` does NOT follow symlinks, so nothing outside a folder is listed.
# ro='1' marks a read-only surface (web:'view'); the editor locks it. kind is the registry
# 'web' value (view/file/patch/types/...) so the editor can pick a surface-specific view.
# Folder files are always ro='0', kind 'file'. This is
# the ONE authority for what may be read: a config request must name a relpath this function
# produced, so no caller-invented path can ever escape.
emit_allowed() {
  if [ -n "$CONFIG_MAP" ]; then
    printf '%s\n' "$CONFIG_MAP" | while IFS=$'\t' read -r _name _rel _grp _label _ro _kind _about _abouturl; do
      [ -n "$_name" ] || continue
      [ -n "$_grp" ]   || _grp='General'
      [ -n "$_label" ] || _label="$_name"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$_grp" "$_name" "$_rel" "$_label" "${_ro:-0}" "${_kind:-file}" "$_about" "$_abouturl"
    done
  fi
  if [ -n "$CONFIG_DIRS" ]; then
    # Each line: group<TAB>reldir<TAB>subfolders(comma-sep). Files come from the
    # ROOT of reldir (non-recursive) plus the root of each named subfolder — you
    # pick exactly which folders' files appear; nothing recurses into a mission's
    # persistence tree unless you name that subfolder. Per-location cap (1000) is a
    # silent backstop against a pathologically large directory.
    printf '%s\n' "$CONFIG_DIRS" | while IFS=$'\t' read -r _grp _dir _subs; do
      { [ -n "$_grp" ] && [ -n "$_dir" ]; } || continue
      {
        printf '%s\n' "$_dir"
        [ -n "$_subs" ] && printf '%s\n' "$_subs" | tr ',' '\n' | while IFS= read -r _s; do
          [ -n "$_s" ] && printf '%s/%s\n' "$_dir" "$_s"
        done
      } | while IFS= read -r _loc; do
        [ -n "$_loc" ] || continue
        _ld="$SERVER_DIR/$_loc"
        [ -d "$_ld" ] || continue
        find "$_ld" -maxdepth 1 -type f 2>/dev/null | LC_ALL=C sort | {
          _n=0
          while IFS= read -r _f; do
            case "${_f##*/}" in *.defaults.*) continue ;; esac   # hide frozen-default baselines
            if [ -n "$IGNORE_EXT" ]; then
              _e="${_f##*.}"
              case ",$IGNORE_EXT," in *",${_e,,},"*) continue ;; esac   # global ignore-filetype
            fi
            _n=$((_n + 1))
            [ "$_n" -le 1000 ] || break
            printf '%s\t%s\t%s\t%s\t0\tfile\n' "$_grp" "${_f#"$SERVER_DIR"/}" "${_f#"$SERVER_DIR"/}" "${_f#"$SERVER_DIR/$_dir"/}"
          done
        } || true
      done
    done
  fi
  # THE FLIP: every .json/.xml under the server dir is a surface unless something says no.
  # The tables above stay as CURATION (names, groups, labels, about text); this enumeration is
  # the default case. Denied prefixes never appear, .defaults companions ride the compare view
  # only, generated artifacts list read-only. Emitted LAST so a curated row wins the UI's
  # first-listing-wins dedup on relpath.
  find "$SERVER_DIR" \( -name '.*' -o -name 'deploy-stage' \) -prune -o \
       -type f \( -name '*.json' -o -name '*.xml' \) -print 2>/dev/null | LC_ALL=C sort | {
    _n=0
    while IFS= read -r _f; do
      _rel="${_f#"$SERVER_DIR"/}"
      case "${_rel##*/}" in *.defaults.*) continue ;; esac
      _denied "$_rel" && continue
      _n=$((_n + 1))
      [ "$_n" -le 2000 ] || break
      _ro=0; _is_generated "$_rel" && _ro=1
      case "$_rel" in
        mpmissions/*/*/*) _rest="${_rel#mpmissions/*/}"; _grp="${_rest%%/*}"; _lbl="$_rest" ;;
        mpmissions/*/*)   _rest="${_rel#mpmissions/*/}"; _grp='mission root'; _lbl="$_rest" ;;
        */*)              _grp="${_rel%%/*}"; _lbl="${_rel#*/}" ;;
        *)                _grp='General'; _lbl="$_rel" ;;
      esac
      printf '%s\t%s\t%s\t%s\t%s\tfile\t\t\n' "$_grp" "$_rel" "$_rel" "$_lbl" "$_ro"
    done
  } || true
  return 0
}

# --- Update system helpers (see the update-arm/disarm/status verbs) ----------------
# The DayZ deploy owns the update MACHINERY (update.sh + prestart.sh apply it, update-check.sh
# arms it on a timer). dayz-ctl only crosses the privilege bridge to: arm/disarm the pending
# flag (the server dir is the game user's, unwritable by the API service account) and read the
# status the machinery leaves behind. State files, all under SERVER_DIR:
#   .update-pending  present = an update is queued for the next start (first line = reason)
#   .update-check    last auto-check: installedBuild/latestBuild/checkedAt/checkOk (KEY=VALUE)
#   .update-lastrun  last applied update: started/finished/exitCode/ok/from/to/reason (KEY=VALUE)
#   .update-lastlog  tail of the last update's steamcmd output (plain text)
UPDATE_PENDING="$SERVER_DIR/.update-pending"
UPDATE_MANIFEST="$SERVER_DIR/steamapps/appmanifest_223350.acf"

# Value for KEY from a KEY=VALUE file (first match; keeps any '=' in the value). Fail-safe
# under set -e: a missing file (sed exits 2) or SIGPIPE from head must yield empty, not abort.
_kv() { [ -f "$2" ] || return 0; sed -n "s/^$1=//p" "$2" 2>/dev/null | head -1 || true; }

# Installed server APP build id from the Steam manifest on disk (empty if absent). Must be
# fail-safe: this script runs under `set -e`, so guard the missing-file / no-match / SIGPIPE
# cases so a status read never aborts just because the manifest isn't there yet.
_installed_build() {
  [ -f "$UPDATE_MANIFEST" ] || return 0
  grep -oE '"buildid"[[:space:]]*"[0-9]+"' "$UPDATE_MANIFEST" 2>/dev/null | grep -oE '[0-9]+' | head -1 || true
}

# Emit the update status as one JSON object on stdout. Values come from the manifest +
# the state files; string fields go through jq/python3 so arbitrary log/reason text is
# safely escaped. jq preferred, python3 fallback (matching this script's other JSON paths).
emit_update_status() {
  local installed latest checkedAt checkOkRaw updateAvailable pending pendingReason
  installed="$(_installed_build)"
  latest="$(_kv latestBuild "$SERVER_DIR/.update-check")"
  checkedAt="$(_kv checkedAt "$SERVER_DIR/.update-check")"
  checkOkRaw="$(_kv checkOk "$SERVER_DIR/.update-check")"
  updateAvailable=false
  [ "$checkOkRaw" = 1 ] && [ -n "$latest" ] && [ -n "$installed" ] && [ "$latest" != "$installed" ] && updateAvailable=true
  pending=false; pendingReason=""
  [ -f "$UPDATE_PENDING" ] && { pending=true; pendingReason="$(head -1 "$UPDATE_PENDING" 2>/dev/null || true)"; }

  local hasLast=false lrStarted="" lrFinished="" lrExit="" lrOkRaw="" lrFrom="" lrTo="" lrReason="" lrLog=""
  if [ -f "$SERVER_DIR/.update-lastrun" ]; then
    hasLast=true
    lrStarted="$(_kv startedAt "$SERVER_DIR/.update-lastrun")"
    lrFinished="$(_kv finishedAt "$SERVER_DIR/.update-lastrun")"
    lrExit="$(_kv exitCode "$SERVER_DIR/.update-lastrun")"
    lrOkRaw="$(_kv ok "$SERVER_DIR/.update-lastrun")"
    lrFrom="$(_kv fromBuild "$SERVER_DIR/.update-lastrun")"
    lrTo="$(_kv toBuild "$SERVER_DIR/.update-lastrun")"
    lrReason="$(_kv reason "$SERVER_DIR/.update-lastrun")"
    lrLog="$(cat "$SERVER_DIR/.update-lastlog" 2>/dev/null || true)"
  fi

  # Export for the JSON engines (avoids all arg-quoting); booleans/numbers converted inside.
  export U_installed="$installed" U_latest="$latest" U_checkedAt="$checkedAt" \
         U_checkOk="$checkOkRaw" U_updateAvailable="$updateAvailable" \
         U_pending="$pending" U_pendingReason="$pendingReason" U_hasLast="$hasLast" \
         U_lrStarted="$lrStarted" U_lrFinished="$lrFinished" U_lrExit="$lrExit" \
         U_lrOk="$lrOkRaw" U_lrFrom="$lrFrom" U_lrTo="$lrTo" U_lrReason="$lrReason" U_lrLog="$lrLog"

  if command -v jq >/dev/null 2>&1; then
    jq -n '
      def nz: if . == "" then null else . end;
      def numornull: if test("^[0-9]+$") then tonumber else null end;
      {
        installedBuild:  ($ENV.U_installed | nz),
        latestBuild:     ($ENV.U_latest | nz),
        updateAvailable: ($ENV.U_updateAvailable == "true"),
        checkedAt:       ($ENV.U_checkedAt | nz),
        checkOk:         ($ENV.U_checkOk == "1"),
        pending:         ($ENV.U_pending == "true"),
        pendingReason:   ($ENV.U_pendingReason | nz),
        lastRun: (if $ENV.U_hasLast == "true" then {
          startedAt:  ($ENV.U_lrStarted | nz),
          finishedAt: ($ENV.U_lrFinished | nz),
          exitCode:   ($ENV.U_lrExit | numornull),
          ok:         ($ENV.U_lrOk == "1"),
          fromBuild:  ($ENV.U_lrFrom | nz),
          toBuild:    ($ENV.U_lrTo | nz),
          reason:     ($ENV.U_lrReason | nz),
          log:        ($ENV.U_lrLog | nz)
        } else null end)
      }'
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c '
import os, json
def nz(v): return v if v else None
e = os.environ
last = None
if e.get("U_hasLast") == "true":
    ex = e.get("U_lrExit", "")
    last = {
        "startedAt": nz(e.get("U_lrStarted")), "finishedAt": nz(e.get("U_lrFinished")),
        "exitCode": int(ex) if ex.isdigit() else None, "ok": e.get("U_lrOk") == "1",
        "fromBuild": nz(e.get("U_lrFrom")), "toBuild": nz(e.get("U_lrTo")),
        "reason": nz(e.get("U_lrReason")), "log": nz(e.get("U_lrLog")),
    }
print(json.dumps({
    "installedBuild": nz(e.get("U_installed")), "latestBuild": nz(e.get("U_latest")),
    "updateAvailable": e.get("U_updateAvailable") == "true", "checkedAt": nz(e.get("U_checkedAt")),
    "checkOk": e.get("U_checkOk") == "1", "pending": e.get("U_pending") == "true",
    "pendingReason": nz(e.get("U_pendingReason")), "lastRun": last,
}))'
  else
    die "update-status: no JSON tool (jq/python3) on the box"
  fi
}

verb="${1:-}"
arg="${2:-}"

case "$verb" in
  restart|start|stop)
    exec systemctl "$verb" "$UNIT"
    ;;

  status)
    # Print active/inactive/... and always exit 0 (status is a query, not a failure).
    systemctl is-active "$UNIT" || true
    ;;

  players)
    [ -f "$RCON" ] || die "rcon script not found: $RCON"
    exec pwsh -NoProfile -File "$RCON" "$SERVER_DIR" players
    ;;

  broadcast)
    [ -n "$arg" ] || die "broadcast needs a message"
    # Second line of defence: printable ASCII only, capped. The service sanitizes
    # too, but this script trusts nothing it is handed.
    msg="$(printf '%s' "$arg" | tr -cd '\11\12\40-\176' | cut -c1-200)"
    [ -n "$msg" ] || die "empty message after sanitising"
    [ -f "$RCON" ] || die "rcon script not found: $RCON"
    exec pwsh -NoProfile -File "$RCON" "$SERVER_DIR" "say -1 $msg"
    ;;

  set-map)
    # Validate the mission NAME (no path traversal) AND that it is actually installed,
    # then persist it and restart. Exit 2 specifically = unknown mission (the service
    # maps that to a 400 for the caller).
    case "$arg" in
      ''|*/*|*..*) die "invalid mission name" ;;
    esac
    [ -d "$SERVER_DIR/mpmissions/$arg" ] || { echo "dayz-ctl: mission not installed: $arg" >&2; exit 2; }
    printf 'DAYZ_MISSION=%s\n' "$arg" > "$SERVER_DIR/map.env"
    exec systemctl restart "$UNIT"
    ;;

  log-sources)
    # log-sources — the browsable log-source registry (deploy.config.json Dayz.LogSources),
    # one per line: id<TAB>label. Feeds the viewer's source selector. No caller input.
    printf '%s\n' "$LOG_SOURCES" | awk -F'\t' 'NF>=4{print $1"\t"$4}'
    ;;

  log-list)
    # These log verbs exist because the service user cannot traverse into the game
    # user's home (0750), so log reads cross the same sudo bridge as everything else.
    # log-list <source-id> — enumerate ONE source's files (deploy.config.json
    # Dayz.LogSources), newest first, capped at 200. The id selects a fixed dir + glob
    # from the rendered registry; no caller input forms a path. Output per file:
    #   name<TAB>bytes<TAB>mtime-iso
    # Exit 2 = unknown source id.
    src="${arg:-rpt}"
    meta="$(log_source_lookup "$src")" || { echo "dayz-ctl: unknown log source: $src" >&2; exit 2; }
    dir="${meta%%$'\t'*}"; glob="${meta#*$'\t'}"
    find "$SERVER_DIR/$dir" -maxdepth 1 -type f -name "$glob" -printf '%T@\t%s\t%f\n' 2>/dev/null \
      | sort -rn | head -n 200 | while IFS="$(printf '\t')" read -r ts sz name; do
        printf '%s\t%s\t%s\n' "$name" "$sz" "$(date -u -d "@${ts%.*}" +%Y-%m-%dT%H:%M:%SZ)"
      done
    ;;

  log-read)
    # log-read <source-id> <name|@newest> <start> <count> [pattern] [ci] [raw] — read a
    # LINE RANGE of one log file within a declared source (deploy.config.json
    # Dayz.LogSources), optionally only the lines matching an ERE pattern (grep -E).
    # <source-id> selects a fixed dir + filename glob; <name> is either @newest (the
    # newest file of that source) or a bare filename that MUST match the source's glob
    # and already exist in the source dir — the caller never forms a path, and any name
    # with a slash, dots-trick or a shape the source glob rejects dies before touching
    # the filesystem.
    #
    # NOISE PRE-FILTER: lines matching NOISE_RE (engine spam like Sakhal's
    # "Unknown object class 'pond'") are hidden by default — dropped BEFORE
    # counting and paging, so offsets index the visible stream and returned lines
    # keep their original numbers. 'raw' as arg 8 disables it. NOISE_RE is
    # prefix-safe by contract (no ^, can't match a "1234:" prefix — enforced at
    # render time), so applying it to numbered streams is exact. It is inert on mod
    # logs whose lines don't match the RPT-oriented pattern.
    #
    # <start> is 1-based within the visible/matched line stream; 0 = "the last
    # <count> lines" (tail mode). <count> is hard-capped at 500, pattern at 256
    # chars, 'ci' as arg 7 makes the match case-insensitive. Output contract:
    #   line 1: the file's full path
    #   line 2: total<TAB>matched<TAB>start<TAB>hidden
    #           (total = raw file lines; matched = pageable lines after noise +
    #            pattern; hidden = lines the noise filter removed)
    #   rest:   <original-line-number>:<line text>
    # Exit 2 = unknown source or no such log, 3 = bad pattern.
    src="$arg"
    name="${3:-@newest}"; start="${4:-0}"; count="${5:-100}"; pattern="${6:-}"; ci="${7:-}"; rawmode="${8:-}"
    meta="$(log_source_lookup "$src")" || { echo "dayz-ctl: unknown log source: $src" >&2; exit 2; }
    dir="${meta%%$'\t'*}"; glob="${meta#*$'\t'}"
    case "$start" in ''|*[!0-9]*) die "log start must be a number (0 = tail)" ;; esac
    case "$count" in ''|*[!0-9]*|0) die "log count must be a number >= 1" ;; esac
    [ "$count" -le 500 ] || count=500
    [ "${#pattern}" -le 256 ] || die "log pattern too long (max 256 chars)"
    case "$name" in
      @newest)
        # shellcheck disable=SC2086  # $glob must stay unquoted so the shell expands it
        file="$(ls -t "$SERVER_DIR/$dir/"$glob 2>/dev/null | head -1)"
        [ -n "$file" ] || { echo "dayz-ctl: no files for log source: $src" >&2; exit 2; }
        ;;
      *[!A-Za-z0-9._-]*|''|.*) die "log name must be a bare filename" ;;
      *)
        # The name must match the source's own declared glob (defence in depth on top
        # of the bare-filename check) and resolve to an existing file in the source dir.
        case "$name" in
          $glob) ;;
          *) die "log name does not match the source pattern" ;;
        esac
        file="$SERVER_DIR/$dir/$name"
        [ -f "$file" ] || { echo "dayz-ctl: no such log: $name" >&2; exit 2; }
        ;;
    esac
    ciflag=''; [ "$ci" != ci ] || ciflag='-i'
    noise="$NOISE_RE"
    [ "$rawmode" != raw ] || noise=''
    total="$(wc -l < "$file")"
    hidden=0
    if [ -n "$noise" ]; then
      set +e; hidden="$(grep -cE -e "$noise" "$file")"; set -e
      hidden="${hidden:-0}"
    fi
    if [ -n "$pattern" ]; then
      # Probe the regex once against /dev/null: grep exit 2 = invalid pattern.
      set +e; grep -nE $ciflag -e "$pattern" /dev/null >/dev/null 2>&1; rc=$?; set -e
      [ "$rc" -le 1 ] || { echo "dayz-ctl: bad pattern (grep -E syntax)" >&2; exit 3; }
      if [ -n "$noise" ]; then
        set +e; matched="$({ grep -E $ciflag -e "$pattern" "$file" || true; } | grep -cvE -e "$noise")"; set -e
      else
        set +e; matched="$(grep -cE $ciflag -e "$pattern" "$file")"; set -e
      fi
      matched="${matched:-0}"
    else
      matched=$(( total - hidden ))
    fi
    [ "$start" -ge 1 ] || start=$(( matched - count + 1 ))
    [ "$start" -ge 1 ] || start=1
    end=$(( start + count - 1 ))
    printf '%s\n' "$file"
    printf '%s\t%s\t%s\t%s\n' "$total" "$matched" "$start" "$hidden"
    # grep may exit 1 (no match) or 141 (SIGPIPE from sed's early quit) — both fine.
    if [ -n "$pattern" ] && [ -n "$noise" ]; then
      { grep -nE $ciflag -e "$pattern" "$file" || true; } | { grep -vE -e "$noise" || true; } | sed -n "${start},${end}p;${end}q"
    elif [ -n "$pattern" ]; then
      { grep -nE $ciflag -e "$pattern" "$file" || true; } | sed -n "${start},${end}p;${end}q"
    elif [ -n "$noise" ]; then
      { grep -nvE -e "$noise" "$file" || true; } | sed -n "${start},${end}p;${end}q"
    else
      awk -v s="$start" -v e="$end" 'NR>e{exit} NR>=s{print NR":"$0}' "$file"
    fi
    ;;

  bandit-log)
    # bandit-log [count] — the newest AIB Unleashed log's SPAWN/KILLED lines (each carries
    # coordinates), for the map's live-bandit overlay. Only a numeric count reaches this; the
    # path is fixed under the profiles dir, so no caller input forms it. Output:
    #   line 1: the file's full path
    #   rest:   the matched SPAWN/KILLED lines, oldest first (newest last)
    # Exit 2 = no AIB log yet (fresh server / mod off) — the caller treats that as "none".
    n="${2:-400}"
    case "$n" in ''|*[!0-9]*|0) n=400 ;; esac
    [ "$n" -le 2000 ] || n=2000
    file="$(ls -t "$SERVER_DIR/profiles/AIB_Unleashed/Logs/"AIB_UL_*.log 2>/dev/null | head -1)"
    [ -n "$file" ] && [ -f "$file" ] || { echo "dayz-ctl: no AIB Unleashed log under profiles/AIB_Unleashed/Logs/" >&2; exit 2; }
    printf '%s\n' "$file"
    { grep -aE 'SPAWN:|KILLED:' "$file" || true; } | tail -n "$n"
    ;;

  live-ai)
    # live-ai — living NPC snapshot the CustomServerMods LiveTracker serverMod writes to
    # profiles/LiveTracker/ai.json every 20s (even with zero NPCs, so the file MTIME is a
    # liveness heartbeat). One JSON envelope on stdout:
    #   {"ageSec": <now - mtime, seconds>, "positions": <file contents: [{"x":..,"z":..,"type":..,"age":..}, ...]>}
    # ageSec lets the API reject a frozen file (server/mod down) instead of plotting ghosts —
    # the file is never copied (read in-place here), so mtime is trustworthy. A read landing
    # mid-write may embed partial JSON; the API treats an unparseable envelope as transient.
    # Exit 2 = file absent (mod not loaded, or server booted <20s ago) — caller treats as "none".
    f="$SERVER_DIR/profiles/LiveTracker/ai.json"
    [ -f "$f" ] || { echo "dayz-ctl: no ai.json (LiveTracker serverMod not loaded yet?)" >&2; exit 2; }
    age=$(( $(date +%s) - $(stat -c %Y "$f") ))
    printf '{"ageSec":%d,"positions":%s}\n' "$age" "$(cat "$f")"
    ;;

  live-players)
    # live-players — connected players ANONYMIZED to [{x,z}], same LiveTracker file family
    # (profiles/LiveTracker/players.json, rewritten every 20s). REPLACES the old .ADM scrape:
    # 20s-fresh instead of the admin log's minutes-scale cadence. Envelope adds "at" (HH:MM:SS
    # box-clock of the last write) for the map's freshness hint. Same ageSec/exit-2 contract.
    f="$SERVER_DIR/profiles/LiveTracker/players.json"
    [ -f "$f" ] || { echo "dayz-ctl: no players.json (LiveTracker serverMod not loaded yet?)" >&2; exit 2; }
    mt=$(stat -c %Y "$f")
    age=$(( $(date +%s) - mt ))
    printf '{"ageSec":%d,"at":"%s","positions":%s}\n' "$age" "$(date -d @"$mt" +%H:%M:%S)" "$(cat "$f")"
    ;;

  live-ship)
    # live-ship — the patrol-ship snapshot the FlyingDutchman serverMod writes to
    # profiles/FlyingDutchman/ship.json every ~20s ([{x,z,state}]; [] while no ship is
    # alive, so the mtime is a heartbeat). Same envelope + exit contract as live-ai.
    # Exit 2 = file absent — the mod ships DORMANT, so this is the normal state until enabled.
    f="$SERVER_DIR/profiles/FlyingDutchman/ship.json"
    [ -f "$f" ] || { echo "dayz-ctl: no ship.json (FlyingDutchman not enabled)" >&2; exit 2; }
    age=$(( $(date +%s) - $(stat -c %Y "$f") ))
    # route.json (patrol loop) + ferry.json (shore boarding pads) ride along for the map, each
    # defaulting to [] when absent so the envelope shape is stable.
    rt="$SERVER_DIR/profiles/FlyingDutchman/route.json"; [ -f "$rt" ] && route="$(cat "$rt")" || route="[]"
    dk="$SERVER_DIR/profiles/FlyingDutchman/ferry.json"; [ -f "$dk" ] && docks="$(cat "$dk")" || docks="[]"
    printf '{"ageSec":%d,"positions":%s,"route":%s,"docks":%s}\n' "$age" "$(cat "$f")" "$route" "$docks"
    ;;

  world-time)
    # world-time — the in-game world clock LiveTracker writes to profiles/LiveTracker/time.json
    # as a one-element array [{year,month,day,hour,minute}] every 20s. Envelope on stdout:
    #   {"ageSec": <now - mtime, seconds>, "clock": <file contents>}
    # ageSec lets the API flag a stale/frozen clock. Exit 2 = file absent (mod not loaded yet).
    f="$SERVER_DIR/profiles/LiveTracker/time.json"
    [ -f "$f" ] || { echo "dayz-ctl: no time.json (LiveTracker serverMod not loaded yet?)" >&2; exit 2; }
    age=$(( $(date +%s) - $(stat -c %Y "$f") ))
    printf '{"ageSec":%d,"clock":%s}\n' "$age" "$(cat "$f")"
    ;;

  config-list)
    # Emit "group<TAB>name<TAB>label<TAB>relpath<TAB>ro<TAB>kind<TAB>about<TAB>aboutUrl" per config:
    # explicit files PLUS every file under each allowlisted folder. The relpath lets the UI dedup
    # a file across its read alias and folder listing; ro='1'
    # tells the editor to lock the row read-only; kind (the registry 'web' value) lets it pick a
    # surface-specific view (e.g. 'types' -> the CE types editor). No caller input reaches this —
    # pure enumeration of the rendered allowlist. Hard-capped at 3000 lines so the reply can never
    # overflow the API's 1MB read buffer (retrieval still works for names past the cap —
    # `config` matches the full set, not this list).
    emit_allowed | awk -F'\t' 'NF>=5{print $1"\t"$2"\t"$4"\t"$3"\t"$5"\t"$6"\t"$7"\t"$8}' | head -n 3000 || true
    ;;

  config-generated)
    # Emit the read-only COMPILER-OUTPUT globs (rendered GENERATED), one ServerDir-relative glob
    # per line. The web editor marks any file matching one of these read-only (no edit/no save);
    # own-write refuses to target one. Pure enumeration of the rendered mask - no caller input.
    if [ -n "$GENERATED" ]; then printf '%s\n' "$GENERATED"; fi
    ;;

  config-owned)
    # Emit the OWNED-surface masks (rendered from registry category:'owned' at deploy time):
    # 'F<TAB><relpath>' per owned file row, 'D<TAB><reldir>' per owned folder row. The web editor
    # uses these to route a row to the whole-file two-copy editor (own-read/own-write) instead of
    # the whole-file editor. Pure enumeration of the rendered masks - no caller input.
    if [ -n "$OWNED_FILES" ]; then printf '%s\n' "$OWNED_FILES" | while IFS= read -r _l; do [ -n "$_l" ] && printf 'F\t%s\n' "$_l"; done; fi
    if [ -n "$OWNED_DIRS" ];  then printf '%s\n' "$OWNED_DIRS"  | while IFS= read -r _l; do [ -n "$_l" ] && printf 'D\t%s\n' "$_l"; done; fi
    # 'E<TAB><relpath>' per owned file that HAS a captured baseline beside it. own-write freezes a
    # .defaults companion before its FIRST replace, so the companion existing means this file has
    # been saved through the editor at least once - which is what the tree marks as edited.
    # A directory scan, no reads and no hashing: it says "was edited here", never
    # "differs right now", and the wording in the UI has to match that.
    {
      if [ -n "$OWNED_FILES" ]; then printf '%s\n' "$OWNED_FILES"; fi
      if [ -n "$OWNED_DIRS" ]; then
        printf '%s\n' "$OWNED_DIRS" | while IFS= read -r _d; do
          [ -n "$_d" ] && [ -d "$SERVER_DIR/$_d" ] || continue
          find "$SERVER_DIR/$_d" -maxdepth 1 -type f \( -name '*.json' -o -name '*.xml' \) 2>/dev/null |
            while IFS= read -r _f; do printf '%s\n' "${_f#"$SERVER_DIR"/}"; done
        done
      fi
    } | LC_ALL=C sort -u | while IFS= read -r _r; do
      [ -n "$_r" ] || continue
      case "${_r##*/}" in *.defaults.*) continue ;; esac      # a companion is never a row itself
      [ -f "$SERVER_DIR/$(_defaults_path "$_r")" ] && printf 'E\t%s\n' "$_r"
    done
    ;;

  config-disabled)
    # Emit the config surfaces whose owning mod is DISABLED in mods.conf (rendered DISABLED_TARGETS
    # from config-registry.json 'mod' fields cross-referenced with deploy/mods.conf at deploy time),
    # one ServerDir-relative relpath per line. The web editor DROPS any row matching one,
    # so a mod turned off stops surfacing its config files -
    # the box-owned patches stay intact, just hidden. Pure enumeration of the rendered mask - no caller input.
    if [ -n "$DISABLED_TARGETS" ]; then printf '%s\n' "$DISABLED_TARGETS"; fi
    ;;

  config)
    # config <name> — print ONE allowlisted config file. The NAME must EXACTLY match
    # one emit_allowed produced (an explicit file, or a real file under an allowlisted
    # folder). The caller never forms a path: a name not in the enumerated set — any
    # '..' trick included — simply doesn't match. Output: line 1 = the resolved
    # relpath, the rest = the file's contents.
    [ -n "$arg" ] || die "config needs a name"
    case "$arg" in *..*) die "invalid config name" ;; esac
    case "$arg" in *[!A-Za-z0-9_./-]*) die "invalid config name" ;; esac
    rel="$(emit_allowed | awk -F'\t' -v n="$arg" '$2==n{print $3; exit}')"
    [ -n "$rel" ] || { echo "dayz-ctl: unknown config: $arg" >&2; exit 2; }
    print_config_file "$rel"
    ;;


  doc-list)
    # Enumerate documentation files across the configured mod-folder roots (DOCS_ROOTS globs),
    # one "mod<TAB>relpath<TAB>relname" line each. Recursive to DOCS_MAXDEPTH, filtered by is_doc
    # (extension in DOCS_EXT or name in DOCS_NAMES). Pure enumeration — no caller input. This is
    # the docs analogue of config-list; docs live under @mod folders, not the config allowlist.
    [ -n "$DOCS_ROOTS" ] || exit 0
    _md="${DOCS_MAXDEPTH:-3}"; case "$_md" in ''|*[!0-9]*) _md=3 ;; esac
    {
      for _glob in $DOCS_ROOTS; do
        for _root in $SERVER_DIR/$_glob; do
          [ -d "$_root" ] || continue
          find -L "$_root" -maxdepth "$_md" -type f 2>/dev/null | LC_ALL=C sort | while IFS= read -r _f; do
            is_doc "$_f" || continue
            _rel="${_f#"$SERVER_DIR"/}"
            printf '%s\t%s\t%s\n' "${_rel%%/*}" "$_rel" "${_rel#*/}"
          done
        done
      done
    } | head -n 5000
    ;;

  doc-read)
    # doc-read <relpath> — print ONE documentation file (a relpath from doc-list). Validated: no
    # '..', must sit under a DOCS_ROOTS dir, must pass is_doc; then print_config_file re-checks
    # realpath-under-server-dir + size cap + secret mask. Caller can't read a non-doc via this.
    [ -n "$arg" ] || die "doc-read needs a relpath"
    case "$arg" in *..*) die "invalid doc path" ;; esac
    case "$arg" in *[!A-Za-z0-9_@./-]*) die "invalid doc path" ;; esac
    _under=0
    for _glob in $DOCS_ROOTS; do
      for _root in $SERVER_DIR/$_glob; do
        [ -d "$_root" ] || continue
        case "$SERVER_DIR/$arg" in "$_root"/*) _under=1; break 2 ;; esac
      done
    done
    [ "$_under" -eq 1 ] || die "doc path is not under a documentation root"
    is_doc "$arg" || die "not a documentation file"
    print_config_file "$arg"
    ;;

  info)
    # info — one privileged snapshot behind the `status` and `sysload` actions:
    # unit properties, the RUNNING mission + mod list (display names from each
    # mod's meta.cpp), the scheduled-restart deadline from messages.xml, and the
    # on-disk sizes the service user cannot stat itself (profiles/, persistence).
    # Takes NO arguments — nothing to validate, no caller-influenced paths.
    # Output: KEY=VALUE lines, then one 'MOD=<folder>\t<name>' line per mod.
    state="$(systemctl is-active "$UNIT" || true)"
    printf 'STATE=%s\n' "$state"

    ts="$(systemctl show "$UNIT" -p ActiveEnterTimestamp --value || true)"
    since=0
    if [ -n "$ts" ] && [ "$ts" != "n/a" ]; then
      since="$(date -d "$ts" +%s 2>/dev/null || echo 0)"
    fi
    printf 'SINCE=%s\n' "$since"

    pid="$(systemctl show "$UNIT" -p MainPID --value || true)"
    case "$pid" in ''|*[!0-9]*) pid=0 ;; esac
    printf 'PID=%s\n' "$pid"

    for pair in MemoryCurrent:MEM_BYTES TasksCurrent:TASKS CPUUsageNSec:CPU_NSEC NRestarts:NRESTARTS; do
      prop="${pair%%:*}"; key="${pair##*:}"
      val="$(systemctl show "$UNIT" -p "$prop" --value || true)"
      case "$val" in ''|*[!0-9]*) val=0 ;; esac   # "[not set]" when the unit is down
      printf '%s=%s\n' "$key" "$val"
    done

    # Mission + mod line: prefer the RUNNING process cmdline (the truth of what is
    # loaded); fall back to map.env / the installed unit file when the unit is down.
    modline=''
    mission=''
    if [ "$pid" -gt 0 ] && [ -r "/proc/$pid/cmdline" ]; then
      while IFS= read -r -d '' a; do
        case "$a" in
          -mod=*)     modline="${a#-mod=}" ;;
          -mission=*) mission="$(basename "${a#-mission=}")" ;;
        esac
      done < "/proc/$pid/cmdline"
    fi
    if [ -z "$mission" ] && [ -f "$SERVER_DIR/map.env" ]; then
      mission="$(sed -n 's/^DAYZ_MISSION=//p' "$SERVER_DIR/map.env" | head -1)"
    fi
    if [ -z "$modline" ]; then
      modline="$(systemctl cat "$UNIT" 2>/dev/null | sed -n 's/.*"-mod=\([^"]*\)".*/\1/p' | head -1 || true)"
    fi
    case "$mission" in */*|*..*) mission='' ;; esac   # defensive before any path use
    printf 'MISSION=%s\n' "$mission"

    # Scheduled restart: the native messages.xml scheduler stops the server
    # <deadline> minutes after start (systemd Restart=always completes the cycle).
    deadline="$(awk '
      /<message>/               { d=0; s=0 }
      /<deadline>/              { line=$0; gsub(/[^0-9]/, "", line); d=line }
      /<shutdown>1<\/shutdown>/ { s=1 }
      /<\/message>/             { if (s && d) { print d; exit } }
    ' "$SERVER_DIR/messages.xml" 2>/dev/null || true)"
    printf 'DEADLINE_MIN=%s\n' "${deadline:-0}"

    logb="$(du -sb "$SERVER_DIR/profiles" 2>/dev/null | cut -f1 || true)"
    printf 'LOG_DIR_BYTES=%s\n' "${logb:-0}"
    stob=''
    if [ -n "$mission" ] && [ -d "$SERVER_DIR/mpmissions/$mission/storage_1" ]; then
      stob="$(du -sb "$SERVER_DIR/mpmissions/$mission/storage_1" 2>/dev/null | cut -f1 || true)"
    fi
    printf 'STORAGE_BYTES=%s\n' "${stob:-0}"

    if [ -n "$modline" ]; then
      # %s\n, not %s: read skips a final entry that lacks a trailing newline.
      printf '%s\n' "$modline" | tr ';' '\n' | while IFS= read -r m; do
        [ -n "$m" ] || continue
        name=''
        case "$m" in
          */*|*..*) : ;;   # never follow a path-shaped entry
          *)
            meta="$SERVER_DIR/$m/meta.cpp"
            if [ -f "$meta" ]; then
              name="$(sed -n 's/.*name[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$meta" | head -1 | tr -d '\r')"
            fi
            ;;
        esac
        printf 'MOD=%s\t%s\n' "$m" "${name:-$m}"
      done
    fi
    ;;

  file-list)
    # Enumerate the box-owned files an admin may REPLACE (the rendered WRITE_MAP), one
    # "name<TAB>relpath" line each. Pure enumeration - no caller input. Empty map = none.
    [ -n "$WRITE_MAP" ] && printf '%s\n' "$WRITE_MAP"
    ;;

  own-read)
    # own-read <relpath> — print ONE category-'owned' config file whole: line 1 = sha256 (the
    # base= for own-write), rest = RAW contents (the editor round-trips it back, so no redaction
    # backstop - safe because 'owned' rows are game/mod config, never secret-bearing files, and
    # _own_check refuses anything but .json/.xml outright). THE generic read of the two-copy model.
    [ -n "$arg" ] || die "own-read needs a relpath"
    _own_check "$arg" read || exit $?
    file="$SERVER_DIR/$arg"
    sha256sum "$file" | awk '{print $1}'
    cat "$file"
    ;;

  own-write)
    # own-write <doc|-> <relpath> [base=<sha256>] — REPLACE one category-'owned' config file
    # whole. THE generic write of the two-copy target model.
    # The doc rides $2 ('-' = stdin, 2MB cap), replace-only,
    # validated BEFORE the write (parse by extension: .json = JSON, .xml = well-formed XML),
    # base= optimistic concurrency (exit 5 = conflict, the editor says "reload"), snapshot the
    # outgoing version to .own-versions/ (keep 30, flattened relpath names), atomic tmp+mv.
    rel="${3:-}"
    [ -n "$rel" ] || die "own-write needs a relpath"
    _own_check "$rel" || exit $?
    file="$SERVER_DIR/$rel"
    if [ "$arg" = "-" ]; then arg="$(head -c 2097153 -)"; fi
    [ -n "$arg" ] || die "own-write needs the new document"
    sz="$(printf '%s' "$arg" | wc -c)"
    [ "$sz" -le 2097152 ] || die "own-write: too large ($sz bytes)"
    case "$rel" in
      *.json)
        if command -v python3 >/dev/null 2>&1; then
          printf '%s' "$arg" | python3 -c 'import sys, json; json.load(sys.stdin)' 2>/dev/null || die "own-write: input is not valid JSON"
        elif command -v jq >/dev/null 2>&1; then
          printf '%s' "$arg" | jq -e . >/dev/null 2>&1 || die "own-write: input is not valid JSON"
        else die "own-write: no JSON validator (python3/jq) on the box"; fi ;;
      *.xml)
        if command -v python3 >/dev/null 2>&1; then
          printf '%s' "$arg" | python3 -c 'import sys, xml.etree.ElementTree as ET; ET.fromstring(sys.stdin.read())' 2>/dev/null || die "own-write: input is not well-formed XML"
        elif command -v xmllint >/dev/null 2>&1; then
          printf '%s' "$arg" | xmllint --noout - 2>/dev/null || die "own-write: input is not well-formed XML"
        else die "own-write: no XML validator (python3/xmllint) on the box"; fi ;;
      *) echo "own-write: no validator for this file type - saved unvalidated: $rel" >&2 ;;
    esac
    # STRUCTURAL check, on top of well-formedness: a registry row can name a validator via its
    # 'structure' field (rendered into OWNED_CHECKS as "glob<TAB>check"), so a half-pasted
    # document can never reach the surface it protects. A named check the box cannot run =
    # refuse - never write an unchecked file to a checked surface.
    _check=''
    if [ -n "$OWNED_CHECKS" ]; then
      while IFS="$(printf '\t')" read -r _cp _cn; do
        [ -n "$_cp" ] || continue
        case "$rel" in $_cp) _check="$_cn"; break ;; esac
      done <<EOF
$OWNED_CHECKS
EOF
    fi
    case "$_check" in
      '') : ;;
      ce-types)
        # CE types document: root <types>, every child a <type name=...>.
        if command -v python3 >/dev/null 2>&1; then
          printf '%s' "$arg" | python3 -c '
import sys, xml.etree.ElementTree as ET
r = ET.fromstring(sys.stdin.read())
assert r.tag == "types", "root element must be <types>"
for c in r:
    assert c.tag == "type" and c.get("name"), "every child must be <type name=...>"
' 2>/dev/null || die "own-write: not a valid CE types document (root <types>, only <type name=...> children)"
        else die "own-write: no python3 on the box to structurally check a CE types file"; fi ;;
      ai-patrols)
        # Expansion AI patrols: object root, Patrols array, unique non-empty Names. Names key
        # the mod's persistence - a duplicate silently merges two patrols' state.
        if command -v python3 >/dev/null 2>&1; then
          printf '%s' "$arg" | python3 -c '
import sys, json
d = json.load(sys.stdin)
assert isinstance(d, dict), "root must be a JSON object"
a = d.get("Patrols")
assert isinstance(a, list), "must have a Patrols array"
names = [e.get("Name", "") for e in a if isinstance(e, dict)]
ne = [n for n in names if n]
assert len(ne) == len(set(ne)), "duplicate Name"
' 2>/dev/null || die "own-write: invalid AIPatrolSettings (object root, Patrols array, unique non-empty Names)"
        else die "own-write: no python3 on the box to structurally check AIPatrolSettings"; fi ;;
      *) die "own-write: unknown structural check '$_check' for $rel" ;;
    esac
    _base='__none__'
    for _f in "${@:4}"; do case "$_f" in base=*) _base="${_f#base=}" ;; esac; done
    if [ "$_base" != '__none__' ]; then
      _cur="$(sha256sum "$file" | awk '{print $1}')"
      [ "$_base" = "$_cur" ] || { echo "dayz-ctl: conflict: $rel changed since you loaded it — reload and re-apply" >&2; exit 5; }
    fi
    # CAPTURE-ON-WRITE. Keep the ORIGINAL bytes of a server/mod-made config the first time we
    # modify it, so there is always a state 0 to roll back to.
    #
    # It MUST happen here, before the replace: capturing at prestart instead runs AFTER the
    # edit and freezes the edit itself as the baseline.
    #
    # No origin classification is needed: own-write is replace-only (_own_check requires the
    # file to exist), so every target pre-existed. Capture if missing, never re-capture -
    # a second capture would overwrite state 0 with state 1, which is the bug above.
    _def="$(_defaults_path "$rel")"
    if [ -n "$_def" ] && [ ! -f "$SERVER_DIR/$_def" ]; then
      cp -p "$file" "$SERVER_DIR/$_def" 2>/dev/null || true
    fi
    OWN_VERSIONS="$SERVER_DIR/.own-versions"
    mkdir -p "$OWN_VERSIONS"
    _flat="$(printf '%s' "$rel" | tr '/' '_')"
    cp -p "$file" "$OWN_VERSIONS/$_flat.$(date -u +%Y%m%dT%H%M%S%NZ)"
    find "$OWN_VERSIONS" -maxdepth 1 -name "$_flat.*" | sort -r | tail -n +31 \
      | while IFS= read -r _old; do rm -f "$_old"; done
    _ownr="$(stat -c '%u:%g' "$SERVER_DIR" 2>/dev/null || echo '')"
    [ -n "$_ownr" ] && chown -R "$_ownr" "$OWN_VERSIONS" 2>/dev/null || true
    tmp="$(mktemp "$SERVER_DIR/.own-write.XXXXXX")"
    printf '%s' "$arg" > "$tmp"
    [ -n "$_ownr" ] && chown "$_ownr" "$tmp" 2>/dev/null || true
    chmod 644 "$tmp"
    mv -f "$tmp" "$file"
    printf 'ok\n%s\n' "$(sha256sum "$file" | awk '{print $1}')"   # line 2 = the new version
    ;;

  update-arm)
    # update-arm [reason] — ARM a deferred update: write .update-pending so the NEXT server
    # start (prestart.sh) pulls the latest app + mods. Does NOT download or restart anything.
    # The reason is a free-text note surfaced in the status; sanitized (printable ASCII, one
    # line, capped) since it's operator-supplied. Owner restored so a later ubuntu-run deploy
    # can still manage the file. Idempotent — re-arming just refreshes the note.
    reason="$(printf '%s' "${arg:-manual: queued via API}" | tr -cd '\11\40-\176' | tr '\t' ' ' | cut -c1-200)"
    [ -n "$reason" ] || reason="manual: queued via API"
    _own="$(stat -c '%u:%g' "$SERVER_DIR" 2>/dev/null || echo '')"
    tmp="$(mktemp "$SERVER_DIR/.update-arm.XXXXXX")"
    printf '%s\n' "$reason" > "$tmp"
    [ -n "$_own" ] && chown "$_own" "$tmp" 2>/dev/null || true
    chmod 644 "$tmp"
    mv -f "$tmp" "$UPDATE_PENDING"
    echo ok
    ;;

  update-disarm)
    # update-disarm — clear a queued update (remove .update-pending). No-op if not armed.
    rm -f "$UPDATE_PENDING"
    echo ok
    ;;

  update-status)
    # update-status — one JSON object: installed vs latest build, updateAvailable, whether an
    # update is armed (+ reason), and the last applied update's outcome (+ log tail). Read-only;
    # no caller input. See emit_update_status above for the field contract.
    emit_update_status
    ;;

  mission-list)
    # mission-list — installed missions (immediate subdirs of mpmissions/), one name per line,
    # sorted. No caller input. The map-change picker uses this; set-map re-validates the choice.
    [ -d "$SERVER_DIR/mpmissions" ] || exit 0
    find "$SERVER_DIR/mpmissions" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' 2>/dev/null | LC_ALL=C sort || true
    ;;

  *)
    die "unknown verb: ${verb:-<none>} (allowed: restart start stop status players broadcast set-map log-list log-read bandit-log bandit-live config config-list config-generated config-owned config-disabled doc-list doc-read info file-list own-read own-write update-arm update-disarm update-status mission-list)"
    ;;
esac
