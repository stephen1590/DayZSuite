[Unit]
Description=Snapshot DayZ server config (zip per day, 30-day retention, originals untouched)

[Service]
# TEMPLATE: DEPLOY_* placeholders rendered per-host by Deploy-DayZServer.ps1 (host.env).
Type=oneshot
User={{DEPLOY_USER}}
Group={{DEPLOY_GROUP}}
# No file lists: a file is backed up because it has a frozen default beside it, which own-write
# writes the first time that file is edited. Persistence, player data, the game install, mods
# and vendor geometry are never edited, so they never qualify and never need naming here.
ExecStart=/usr/bin/pwsh -NoProfile -File {{DEPLOY_HOME}}/servers/dayz-server/Backup-Snapshot.ps1 -SourceDir {{DEPLOY_HOME}}/servers/dayz-server -ArchiveDir {{DEPLOY_HOME}}/servers/dayz-server/config-backups -Name config -RetentionDays 30 -Fix
